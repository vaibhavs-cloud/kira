{
  "permission": "allow",
  "mcp": {
    "chrome-devtools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest",
        "--browserUrl",
        "http://127.0.0.1:9223",
        "--no-category-emulation",
        "--no-category-performance",
        "--no-category-network",
        "--no-category-memory",
        "--no-usage-statistics"
      ]
    }
  }
}
